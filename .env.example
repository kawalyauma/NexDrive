NODE_ENV=production
PORT=8080
POSTGRES_DB=nexdrive
POSTGRES_USER=nexdrive
POSTGRES_PASSWORD=change-this-to-a-long-random-password
SESSION_SECRET=change-this-to-a-random-64-character-secret
PUBLIC_ORIGIN=https://drive.example.org
DOMAIN=drive.example.org
ALLOW_SIGNUP=false
MAX_UPLOAD_BYTES=268435456
DEFAULT_WORKSPACE_QUOTA_BYTES=10737418240
STORAGE_DIR=/data
